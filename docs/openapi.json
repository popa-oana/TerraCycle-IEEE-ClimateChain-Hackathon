  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HistoryItem": {
        "properties": {
          "year": {
            "type": "integer",
            "maximum": 2026.0,
            "minimum": 1990.0,
            "title": "Year"
          },
          "crop_id": {
            "type": "string",
            "maxLength": 60,
            "minLength": 2,
            "title": "Crop Id"
          }
        },
        "type": "object",
        "required": [
          "year",
          "crop_id"
        ],
        "title": "HistoryItem"
      },
      "PlanRequest": {
        "properties": {
          "parcel_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Parcel Id"
          },
          "season_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Season Id"
          },
          "crop_history": {
            "items": {
              "$ref": "#/components/schemas/HistoryItem"
            },
            "type": "array",
            "minItems": 1,
            "title": "Crop History"
          },
          "treatments": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Treatments",
            "default": []
          },
          "requested_crop_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 2,
            "title": "Requested Crop Id"
          }
        },
        "type": "object",
        "required": [
          "parcel_id",
          "season_id",
          "crop_history",
          "requested_crop_id"
        ],
        "title": "PlanRequest"
      },
      "PlanResponse": {
        "properties": {
          "plan_id": {
            "type": "string",
            "title": "Plan Id"
          },
          "parcel_id": {
            "type": "string",
            "title": "Parcel Id"
          },
          "season_id": {
            "type": "string",
            "title": "Season Id"
          },
          "rotations": {
            "items": {
              "$ref": "#/components/schemas/RotationOption"
            },
            "type": "array",
            "title": "Rotations"
          },
          "climate_source": {
            "type": "string",
            "title": "Climate Source",
            "default": "fixture"
          }
        },
        "type": "object",
        "required": [
          "plan_id",
          "parcel_id",
          "season_id",
          "rotations"
        ],
        "title": "PlanResponse"
      },
      "PrepareRequest": {
        "properties": {
          "plan_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Plan Id"
          },
          "rotation_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Rotation Id"
          },
          "beneficiary_address": {
            "type": "string",
            "pattern": "^0x[0-9a-fA-F]{40}$",
            "title": "Beneficiary Address"
          },
          "verification_policy_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Verification Policy Id"
          }
        },
        "type": "object",
        "required": [
          "plan_id",
          "rotation_id",
          "beneficiary_address",
          "verification_policy_id"
        ],
        "title": "PrepareRequest"
      },
      "PrepareResponse": {
        "properties": {
          "commitment_id": {
            "type": "string",
            "title": "Commitment Id"
          },
          "plan_hash": {
            "type": "string",
            "title": "Plan Hash"
          },
          "parcel_id": {
            "type": "string",
            "title": "Parcel Id"
          },
          "season_id": {
            "type": "string",
            "title": "Season Id"
          },
          "beneficiary_address": {
            "type": "string",
            "title": "Beneficiary Address"
          },
          "settle_deadline": {
            "type": "string",
            "title": "Settle Deadline"
          },
          "snapshot_url": {
            "type": "string",
            "title": "Snapshot Url"
          },
          "state": {
            "type": "string",
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "commitment_id",
          "plan_hash",
          "parcel_id",
          "season_id",
          "beneficiary_address",
          "settle_deadline",
          "snapshot_url",
          "state"
        ],
        "title": "PrepareResponse"
      },
      "RotationCrop": {
        "properties": {
          "year": {
            "type": "integer",
            "title": "Year"
          },
          "crop_id": {
            "type": "string",
            "title": "Crop Id"
          }
        },
        "type": "object",
        "required": [
          "year",
          "crop_id"
        ],
        "title": "RotationCrop"
      },
      "RotationOption": {
        "properties": {
          "rotation_id": {
            "type": "string",
            "title": "Rotation Id"
          },
          "crops": {
            "items": {
              "$ref": "#/components/schemas/RotationCrop"
            },
            "type": "array",
            "title": "Crops"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "explanations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Explanations"
          },
          "risks": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Risks"
          }
        },
        "type": "object",
        "required": [
          "rotation_id",
          "crops",
          "score",
          "explanations",
          "risks"
        ],
        "title": "RotationOption"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
