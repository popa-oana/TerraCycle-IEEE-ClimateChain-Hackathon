    "/api/v1/commitments/{commitment_id}/verify": {
      "post": {
        "tags": [
          "verify"
        ],
        "summary": "Verify Commitment",
        "description": "Verify a funded commitment using satellite evidence.\n\nFlow:\n1. Load commitment and validate state.\n2. Load verification policy from fixture.\n3. Call scientific verifier (verify_parcel).\n4. Build canonical evidence document using evidence builder.\n5. Validate evidence document against canonical schema.\n6. Canonicalize and hash evidence (SHA-256).\n7. Build EIP-712 attestation payload.\n8. Invoke Node signer for EIP-712 signature.\n9. Persist Verdict with evidence snapshot and signature.\n10. Return verification response with attestation and signature.",
        "operationId": "verify_commitment_api_v1_commitments__commitment_id__verify_post",
        "parameters": [
          {
            "name": "commitment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Commitment Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
