VITE_API_BASE_URL=http://localhost:8000

# Origin of the read-only proof server (scripts/serve_demo.py). Optional:
# defaults to http://127.0.0.1:8090. The Vite dev/preview server proxies
# /api/proof to it.
PROOF_SERVER_ORIGIN=http://127.0.0.1:8090

# Absolute base URL of the proof API. Leave empty to use the same-origin
# /api/proof path that the Vite proxy forwards.
VITE_PROOF_BASE_URL=
