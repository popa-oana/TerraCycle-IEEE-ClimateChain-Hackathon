# Copy this file to .env and fill it in. NEVER commit .env.

# --- Docker Postgres (used by docker-compose.yml) ---
POSTGRES_USER=terracycle
POSTGRES_PASSWORD=change_me
POSTGRES_DB=terracycle
POSTGRES_PORT=5432

# --- Backend ---
# Password and port must match the values above (use letters/digits only in the password)
DATABASE_URL=postgresql+psycopg2://terracycle:change_me@localhost:5432/terracycle
ALLOWED_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- Filled in later by the team (public config only) ---
# Leave CHAIN_RPC_URL empty here: Alchemy/Infura URLs contain an API key.
CHAIN_RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=
CONTRACT_ABI_PATH=
MODEL_PATH=
MODEL_METADATA_PATH=
SATELLITE_CACHE_DIR=data/ndvi
VERIFICATION_POLICY_PATH=
SIGNER_SCRIPT_PATH=backend/signer/sign_verdict.mjs
